# AI Recruiter Assistant Backend Configuration

# App
ENVIRONMENT=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# JWT Authentication
# IMPORTANT: Generate a secure key for production!
# Run: openssl rand -hex 32
JWT_SECRET_KEY=dev_secret_key_change_in_production_abc123
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenRouter API (required for vacancy parsing)
# Get your API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_api_key_here
OPENROUTER_MODEL=anthropic/claude-3.5-haiku
OPENROUTER_MODEL_FAST=google/gemini-2.0-flash-001
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI API (required for embeddings)
# Get your API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Redis
REDIS_URL=redis://redis:6379/0
SESSION_EXPIRE_SECONDS=3600

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# PostgreSQL Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/ai_recruiter

# File uploads
MAX_UPLOAD_SIZE_MB=10
