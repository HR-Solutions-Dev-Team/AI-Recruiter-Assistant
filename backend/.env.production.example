# AI Recruiter Assistant Backend Configuration - PRODUCTION
# Скопируйте этот файл в .env и заполните значения

# App
ENVIRONMENT=production
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000

# JWT Authentication
# ВАЖНО: Сгенерируйте безопасный ключ!
# Команда: openssl rand -hex 32
JWT_SECRET_KEY=СГЕНЕРИРУЙТЕ_НОВЫЙ_КЛЮЧ_КОМАНДОЙ_OPENSSL
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenRouter API (для парсинга вакансий)
# Получите ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=ваш_ключ_openrouter
OPENROUTER_MODEL=anthropic/claude-3.5-haiku
OPENROUTER_MODEL_FAST=google/gemini-2.0-flash-001
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI API (для embeddings)
# Получите ключ: https://platform.openai.com/api-keys
OPENAI_API_KEY=ваш_ключ_openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Redis (внутренняя сеть Docker)
REDIS_URL=redis://redis:6379/0
SESSION_EXPIRE_SECONDS=3600

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# PostgreSQL Database (внешняя база данных)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database

# File uploads
MAX_UPLOAD_SIZE_MB=10
